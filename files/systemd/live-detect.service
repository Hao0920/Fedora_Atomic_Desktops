[Unit]
Description=Fedora Atomic GPU Detection and Installation
ConditionKernelCommandLine=live
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/live-select.sh
StandardOutput=tty
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

# 失败不阻塞启动
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
